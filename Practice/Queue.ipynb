   "source": [
    "# creating a queue using list\n",
    "\n",
    "def create(*s):\n",
    "    q = []\n",
    "    q.extend(s)\n",
    "    return q\n",
    "\n",
    "\n",
    "s = create(1, 3)\n",
    "print(s)"
   ]
  },
